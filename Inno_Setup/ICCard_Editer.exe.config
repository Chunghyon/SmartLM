<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<add key="LogPath" value="G:\bytebuflog" />
		<add key="Languages" value="Korean,English,简体,繁体" />
		<add key="Language_简体" value="Language\ICCardEditer\China.xml" />
		<add key="Language_Korean" value="Language\ICCardEditer\Korean.xml" />
		<add key="Language_English" value="Language\ICCardEditer\English.xml" />
		<add key="Language_繁体" value="Language\ICCardEditer\ChinaHK.xml" />
		<add key="ToolLanguage" value="Korean" />
	</appSettings>
	<system.diagnostics>
		<sources>
			<!-- 本节定义 My.Application.Log 的登录配置-->
			<source name="DefaultSource" switchName="DefaultSwitch">
				<listeners>
					<add name="FileLog"/>
					<!-- 取消注释以下一节可写入应用程序事件日志-->
					<!--<add name="EventLog"/>-->
				</listeners>
			</source>
		</sources>
		<switches>
			<add name="DefaultSwitch" value="Information"/>
		</switches>
		<sharedListeners>
			<add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter"/>
			<!-- 取消注释以下一节并用应用程序名替换 APPLICATION_NAME 可写入应用程序事件日志-->
			<!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
		</sharedListeners>
	</system.diagnostics>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
	</startup>

	<runtime>

		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">

			<publisherPolicy apply="yes"/>

			<probing privatePath="dll\net"/>

		</assemblyBinding>

	</runtime>
</configuration>

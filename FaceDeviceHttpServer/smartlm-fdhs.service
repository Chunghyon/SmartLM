[Unit]
Description=SmartLM FaceDevice HTTP Server
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/opt/smartlm
ExecStart=/opt/smartlm/FaceDeviceHttpServer
Restart=always
RestartSec=3
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_EnableDiagnostics=0

[Install]
WantedBy=multi-user.target
